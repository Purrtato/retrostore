# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server
PORT=3000
# Set to "production" on Render (enables secure cookies)
NODE_ENV=development

# Database (Supabase session pooler connection string)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Admin login (sessions)
SESSION_SECRET=generate-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Frontend URL, used for CORS (exact address, no trailing slash)
CLIENT_URL=http://localhost:5173

# Supplier API (Lab 1). Use /chaos/v1 instead of /v1 to test error handling.
SUPPLIER_API_URL=https://leverantor-api.vercel.app/v1
SUPPLIER_API_KEY=your-supplier-api-key
SUPPLIER_BRANCH=elektronik

# Algolia (Lab 2). The write key must only exist on the server.
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_WRITE_KEY=your-algolia-write-key
ALGOLIA_SEARCH_KEY=your-algolia-search-only-key
ALGOLIA_INDEX_NAME=products